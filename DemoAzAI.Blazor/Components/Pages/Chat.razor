@page "/chat"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Contracts.Api.Requests
@using DemoAzAI.Contracts.Api.Responses

@* @inject IExecutionStepTracer StepTracer *@

<PageTitle>Language processing</PageTitle>

<PageDescription Title="Chat"
                 Model="AI Model: gpt-4.1-mini (OpenAI)"
                 Description="Description: A language and semantic processing system capable of generating text using knowledge and patterns learned from large-scale textual data.">
</PageDescription>

<div class="page-area">

    <div class="question-area">
        <form @onsubmit="SendQuestion">
            <label for="question">Ask a question:</label>
            <input @bind="question" placeholder="Type your question..." />

            <button type="submit" class="ask-button" disabled="@isBusy">
                <span>Ask</span>
            </button>

            <!-- call wait panel -->
            @if (isBusy)
            {
                <LoadingPanel Message="Sending question to chat model..."></LoadingPanel>
            }
        </form>
    </div>


    <div class="response_area">
        <div>
            <label for="chatResponse">Response:</label>
            <textarea readonly value="@chatResponse"></textarea>
        </div>

    </div>



</div>

@code {
    private bool isBusy;
    private string question = "This is just a test. No answer is expected.";
    private string chatResponse = string.Empty;
    private string statistics = string.Empty;

    private async Task SendQuestion()
    {
        try
        {
            isBusy = true;

            await RefreshUIAsync();

            var request = new ChatQuestionRequestDto()
            {
                SystemPrompt = "You are a conversational agent. When you answer please prefix your answer with: Hello Mr Potato",
                Prompt = question
            };

            var result = await apiClient.PostAsync<ChatQuestionRequestDto, ChatQuestionResponseDto>("api/chat/questions/answer", request);

            if (result == null || result.Value is null)
            {
                return;

            }
            if (!result.IsSuccess)
            {
                return;
            }

            var responseDto = result.Value;

            chatResponse = responseDto.ChatResponse;

            if (responseDto.ModelStatistics != null)
                statistics = responseDto.ModelStatistics.ToString();


        }
        catch (Exception ex)
        {

            // executionSteps = ex.Message;
            throw;
        }
        finally
        {
            isBusy = false;
        }

    }


}

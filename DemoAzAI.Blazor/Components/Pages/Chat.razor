@page "/chat"
@rendermode InteractiveServer

@using Contracts.Requests
@using Contracts.Responses
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.Api
@using DemoAzAI.Common

@inject FoundryApiClient apiClient

<div class="mt-3">

    <!-- ask button -->
    <form @onsubmit="SendQuestion">
        <label for="question">Ask a question:</label>
        <input @bind="question" placeholder="Type your question..." />

        <button type="submit" class="ask-button" disabled="@isBusy">
            <span>Ask</span>
        </button>

        <!-- call wait panel -->
        @if (isBusy)
        {
            <LoadingPanel Message="Sending question to chat model..."></LoadingPanel>
        }
    </form>

    <!-- response -->
    <div class="response_area">
        <div>
            <label for="chatResponse">Chat response:</label>
            <textarea readonly value="@chatResponse"></textarea>
        </div>

    </div>


    <!-- statistics, log -->
    <div class="stats_log_area">

        <div class="log_area">
            <ExecutionLogPanel ExecutionLog="@executionLog"></ExecutionLogPanel>
        </div>

        <div class="stat_area">
            <label for="statistics">Model statistics:</label>
            <textarea readonly value="@statistics"></textarea>
        </div>

    </div>

</div>

@code {
    private bool isBusy;
    private string question = "This is just a test. No answer is expected.";
    private string chatResponse = string.Empty;
    private string executionLog = string.Empty;
    private string statistics = string.Empty;

    private async Task SendQuestion()
    {
        try
        {
            isBusy = true;

            StepTracer.AddStep("BlazorUi", $"{nameof(SendQuestion)}: Sending question to chat model", clearSteps: true);

            executionLog = StepTracer.GetSteps();
            await RefreshUI();

            var request = new ChatRequestDto()
            {
                Prompt = question
            };

            var result = await apiClient.PostAsync<ChatRequestDto, ChatResponseDto>("api/chat/sendprompt", request);

            if (!result.IsSuccess)
            {
                executionLog = result.ErrorMessage ?? "Unknown API error.";
                return;
            }

            if (result == null || result.Value is null)
            {
                executionLog = "API returned no data.";
                return;
            }

            StepTracer.AddStep("BlazorUi", $"{nameof(SendQuestion)}: Received answer for question: {question}");

            var responseDto = result.Value;

            chatResponse = responseDto.ChatResponse;

            executionLog = StepTracer.GetSteps();

            if (responseDto.ModelStatistics != null)
                statistics = responseDto.ModelStatistics.ToString();


        }
        catch (Exception ex)
        {

            executionLog = ex.Message;
            throw;
        }
        finally
        {
            isBusy = false;
        }

    }

    private async Task RefreshUI()
    {

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

}

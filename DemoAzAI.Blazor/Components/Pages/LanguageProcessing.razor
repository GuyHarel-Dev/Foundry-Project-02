@page "/language-processing"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Contracts.Api.Requests
@using DemoAzAI.Contracts.Api.Responses
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.Api
@using DemoAzAI.Application

@inject ApiClient apiClient
@inject IStepTracer StepTracer

<PageTitle>Language processing</PageTitle>

<PageDescription Title="Language processing"
                 Model="AI Model: gpt-4.1-mini (OpenAI)"
                 Description="Description: A language and semantic processing system capable of generating text using knowledge and patterns learned from large-scale textual data.">
</PageDescription>

<div class="mt-3">



    <!-- ask button -->
    <form @onsubmit="SendQuestion">
        <label for="question">Ask a question:</label>
        <input @bind="question" placeholder="Type your question..." />

        <button type="submit" class="ask-button" disabled="@isBusy">
            <span>Ask</span>
        </button>

        <!-- call wait panel -->
        @if (isBusy)
        {
            <LoadingPanel Message="Sending question to chat model..."></LoadingPanel>
        }
    </form>

    <!-- response -->
    <div class="response_area">
        <div>
            <label for="chatResponse">Response:</label>
            <textarea readonly value="@chatResponse"></textarea>
        </div>

    </div>


    <!-- statistics, log -->
    <div class="stats_log_area">

        <div class="log_area">
            <ExecutionStepsPanel executionSteps="@executionSteps"></ExecutionStepsPanel>
        </div>

        <div class="stat_area">
            <StatisticsPanel Statistics="@statistics"></StatisticsPanel>
        </div>

    </div>

</div>

@code {
    private bool isBusy;
    private string question = "This is just a test. No answer is expected.";
    private string chatResponse = string.Empty;
    private string executionSteps = string.Empty;
    private string statistics = string.Empty;

    private async Task SendQuestion()
    {
        try
        {
            isBusy = true;

            executionSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(SendQuestion)}: Sending question to chat model", clearSteps: true);

            executionSteps = StepTracer.GetSteps();
            await RefreshUI();

            var request = new ChatRequestDto()
            {
                Prompt = question
            };

            var result = await apiClient.PostAsync<ChatRequestDto, ChatResponseDto>("api/chat/sendprompt", request);

            if (result == null || result.Value is null)
            {
                executionSteps = "API returned no data.";
                return;

            }
            if (!result.IsSuccess)
            {
                executionSteps = result.ErrorMessage ?? "Unknown API error.";
                return;
            }


            executionSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(SendQuestion)}: Received answer for question: {question}");

            var responseDto = result.Value;

            chatResponse = responseDto.ChatResponse;

            if (responseDto.ModelStatistics != null)
                statistics = responseDto.ModelStatistics.ToString();


        }
        catch (Exception ex)
        {

            executionSteps = ex.Message;
            throw;
        }
        finally
        {
            isBusy = false;
        }

    }


}

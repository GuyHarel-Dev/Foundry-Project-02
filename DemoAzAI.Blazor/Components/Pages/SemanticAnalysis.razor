@page "/semantic-analysis"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Contracts.Api.Requests
@using DemoAzAI.Contracts.Api.Responses
@using DemoAzAI.Application
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.Api

@inject ApiClient apiClient
@inject IStepTracer StepTracer
@inject ILogger<SemanticAnalysis> Logger

<PageTitle>Semantic Analysis</PageTitle>

<PageDescription Title="Semantic Analysis"
                 Model="AI Model: text-embedding-3-small (OpenAI)"
                 Description="Description: Generates semantic representations used for knowledge retrieval, similarity matching, and intelligent search.">
</PageDescription>

<label for="TextToEmbed">Text to embed:</label>
<textarea @bind="textToEmbed"></textarea>

<form @onsubmit="EmbedTextLines">
    <button type="submit">Generate Embeddings</button>
    <!-- call wait panel -->
    @if (isBusy)
    {
        <LoadingPanel Message="Sending text for embedding to the embedding model..."></LoadingPanel>
    }
</form>

<div>
    <div>
        <label for="embeddedText">Text embedding:</label>
        <textarea readonly value="@embeddedText"></textarea>
    </div>
    <div>
        <label for="executionSteps">Execution log:</label>
        <textarea readonly value="@executionSteps"></textarea>
    </div>


</div>

<div>
    <label for="semanticQuestion">Semantic search:</label>
    <textarea readonly value="@semanticQuestion"></textarea>
    <form @onsubmit="SemanticSearch">
        <button type="submit">Perform semantic search</button>

    </form>

    <div>
        <label for="searchSteps">Semantic search log:</label>
        <textarea readonly value="@searchSteps"></textarea>
    </div>
</div>

@code {

    private bool isBusy;
    private string textToEmbed = TextToEmbedDefault;

    private string embeddedText = string.Empty;
    private string executionSteps = string.Empty;
    private string searchSteps = string.Empty;

    private string semanticQuestion = string.Empty;

    private async Task SemanticSearch()
    {
        if (string.IsNullOrWhiteSpace(semanticQuestion))
        {
            semanticQuestion = "Please enter a semantic question...";
            return;
        }
        ;


        searchSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(SemanticSearch)}: Searching embedding store...");

        var request = new EmbeddingRequestDto
        {
            AddEmbeddingsToStore = false,
            TextLines = semanticQuestion
                .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                .ToList()
        };

        // api/embedding/search/store


        await RefreshUI();
    }

    private async Task EmbedTextLines()
    {

        try
        {
            isBusy = true;

            embeddedText = string.Empty;
            executionSteps = string.Empty;

            executionSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(EmbedTextLines)}: Starting embedding text...", clearSteps: true);

            await RefreshUI();

            List<string> lines = textToEmbed
                .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                .ToList();

            var request = new EmbeddingRequestDto
            {
                AddEmbeddingsToStore = true,
                TextLines = lines
            };

            var result = await apiClient.PostAsync<EmbeddingRequestDto, EmbeddingResponseDto>("api/embedding/embed/chunks", request);

            if (!result.IsSuccess)
            {
                executionSteps = "API returned no data.";
                Logger.LogInformation(result.ErrorMessage);
                return;

            }

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while embedding text lines.");
        }
        finally
        {
            isBusy = false;
        }

    }



    

    private static string TextToEmbedDefault = @"Cats are playful pets
Dogs are loyal animals
Pizza is delicious
Machine learning uses vectors";

}

@page "/document-search"
@rendermode InteractiveServer

@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Common
@using DemoAzAI.Contracts.Requests
@using DemoAzAI.Contracts.Responses
@using DemoAzAI.Contracts.Dtos
@using DemoAzAI.Blazor.Services.Api
@using DemoAzAI.Blazor.Services.UI

@inject FoundryApiClient apiClient
@inject DocumentSearchStateContainer StateContainer;

<h3>AI Document Search</h3>

<div class="">

    <button @onclick='() => SetPdf("/Pdf/fake-occular-center.pdf")'>
        fake-occular-center
    </button>

    <button @onclick='() => SetPdf("/Pdf/fake-lamp-receit.pdf")'>
        fake-lamp-receit
    </button>

    <button @onclick='() => SetPdf("/Pdf/fake-kayak-certificate.pdf")'>
        fake-kayak-certificate
    </button>

</div>

<div class="doc_selection_area">
    <div class="">
        <iframe src="@($"{pdfUrl}#toolbar=0&navpanes=0&scrollbar=0&view=FitH")">
        </iframe>
    </div>
    <div>
        <form @onsubmit="AnalyzeDocument">
            <label>
                <input name="model" type="radio"
                       value="@ReadModel"
                       @onchange="e => OnModelRadioChange(e)" />
                @ReadModel
            </label>

            <label>
                <input name="model" type="radio"
                       value="@LayoutModel"
                       @onchange="e => OnModelRadioChange(e)" />
                @LayoutModel
            </label>

            <label>
                <input name="model" type="radio"
                       value="@InvoiceModel"
                       @onchange="e => OnModelRadioChange(e)" />
                @InvoiceModel
            </label>

            <label>
                <input name="model" type="radio"
                       value="@ReceiptModel"
                       @onchange="e => OnModelRadioChange(e)" />
                @ReceiptModel
            </label>

            <button type="submit" class="ask-button" disabled="@isBusy">
                <span>Analyze document</span>
            </button>

            <!-- call wait panel -->
            @if (isBusy)
            {
                <LoadingPanel></LoadingPanel>
            }
        </form>

    </div>


</div>

<div class="log_stat_area">
    <div>
        <label for="executionLog">Execution log:</label>
        <textarea readonly value="@StateContainer.ExecutionLog"></textarea>
    </div>

    <div>
        <label for="statistics">Model statistics:</label>
        <textarea readonly value="@StateContainer.Statistics"></textarea>
    </div>

</div>

<div class="doc_analysis_area">
    <div>
        <label for="docContent">Document content:</label>
        <textarea readonly value="@StateContainer.DocContent"></textarea>
    </div>

    <div>
        <label for="docFields">Documument fields:</label>
        <textarea readonly value="@StateContainer.DocFields"></textarea>
    </div>


</div>

@code {

    [Inject]
    private IWebHostEnvironment Env { get; set; } = default!;

    private bool isBusy;
    private string pdfUrl = "/Pdf/empty-pdf.pdf";

    private string ReadModel = "prebuilt-read";
    private string LayoutModel = "prebuilt-layout";
    private string InvoiceModel = "prebuilt-invoice";
    private string ReceiptModel = "prebuilt-receipt";

    private string SelectedModel = "prebuilt-read";

    private void OnModelRadioChange(ChangeEventArgs e)
    {
        var test = e.Value;

        SelectedModel = e.Value?.ToString() ?? "prebuilt-read";
    }

    private async Task AnalyzeDocument()
    {
        try
        {
            isBusy = true;

            StateContainer.Statistics = string.Empty;
            StateContainer.ExecutionLog = string.Empty;

            List<StepTracerStepDto> Steps = new();

            StepTracer.AddStep(Steps, "BlazorUi", $"{nameof(AnalyzeDocument)}: Starting analysis for {pdfUrl} with model: {SelectedModel}");

            StateContainer.ExecutionLog = StepTracer.GetTrace(Steps);

            await RefreshUI();

            var request = new AnalyzeDocumentRequestDto(Steps)
            {
                ModelName = SelectedModel,
                FileName = Path.GetFileName(pdfUrl),
                Bytes = await File.ReadAllBytesAsync(Path.Combine(Env.WebRootPath, pdfUrl.TrimStart('/')))

            };

            var result = await apiClient.PostAsync<AnalyzeDocumentRequestDto,
                AnalyzeDocumentResponseDto>("api/document/analyze", request);

            if (!result.IsSuccess)
            {
                StateContainer.ExecutionLog = result.ErrorMessage ?? "Unknown API error.";
                return;
            }

            var responseDto = result.Value;

            if (responseDto == null)
            {
                StateContainer.ExecutionLog = "API returned no data.";
                return;
            }

            ExtractDocumentsContent(responseDto);
            StateContainer.ExecutionLog = StepTracer.GetTrace(responseDto.Steps);
            StateContainer.Statistics = ExtractStatistics(result.Value);

        }
        catch (Exception ex)
        {

            StateContainer.ExecutionLog = ex.Message;
            throw;
        }
        finally
        {
            isBusy = false;
        }

    }

    private void ExtractDocumentsContent(AnalyzeDocumentResponseDto? response)
    {
        if (response == null)
        {
            StateContainer.DocContent = "No response documents or fields to extract.";
            return;
        }

        StateContainer.DocContent = response.DocContent ?? "No document content extracted.";

        // Fields extraction

        if (response.Documents is null)
        {
            StateContainer.DocFields = "No documents fields found in the response.";
            return;
        }


        var contentBuilder = new System.Text.StringBuilder();

        foreach (var doc in response.Documents)
        {
            contentBuilder.AppendLine($"Document Type: {doc.DocumentType}");

            foreach (var field in doc.Fields)
            {
                contentBuilder.AppendLine();
                contentBuilder.AppendLine($"  Field Name: {field.Name}");
                contentBuilder.AppendLine($"  Field Value: {field.Value}");
                contentBuilder.AppendLine($"  Field Confidence: {field.Confidence}");
                contentBuilder.AppendLine($"  Field FieldType: {field.FieldType}");
            }
        }

        StateContainer.DocFields = contentBuilder.ToString();

    }

    private string ExtractStatistics(AnalyzeDocumentResponseDto? response)
    {
        if (response == null)
            return "No response data to extract statistics.";

        string str = "";

        str += $"PageCount: {response.PageCount}\n";
        str += $"ParagraphCount: {response.ParagraphCount}\n";
        str += $"TableCount: {response.TableCount}\n";
        str += $"FigureCount: {response.FigureCount}\n";
        str += $"SectionCount: {response.SectionCount}\n";
        str += $"LanguagesCount: {response.LanguagesCount}\n";
        str += $"LanguagesCount: {response.LanguagesCount}\n";

        // Derived statistics
        str += $"CharacterCount : {response.DocContent.Length}\n";
        str += $"WordCount : {response.DocContent.Split(' ').Length}\n";

        return str;

    }

    private void SetPdf(string url)
    {
        pdfUrl = url;
    }

    private async Task RefreshUI()
    {

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }
}

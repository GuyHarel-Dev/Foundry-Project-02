@page "/document-search"
@rendermode InteractiveServer

@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.Api
@using DemoAzAI.Blazor.Services.UI

@inject FoundryApiClient apiClient
@inject DocumentSearchStateContainer StateContainer;

<h3>AI Document Search</h3>

<button @onclick="e => Test(e)"  >Test</button>

<div class="pdf-model-selection-area">
    <div class="pdf-selection-area">
        <p>Select a PDF document to analyse:</p>
        <button @onclick='() => StateContainer.PdfUrl ="/Pdf/fake-occular-center.pdf"'>
            fake-occular-center
        </button>

        <button @onclick='() => StateContainer.PdfUrl = "/Pdf/fake-lamp-receit.pdf"'>
            fake-lamp-receit
        </button>

        <button @onclick='() => StateContainer.PdfUrl = "/Pdf/fake-kayak-certificate.pdf"'>
            fake-kayak-certificate
        </button>

    </div>

    <div class="ai-model-selection-area">
        <p>Select a model for the analysis:</p>
        <label>
            <input name="model" type="radio"
                   value="@ReadModel"
                   @onchange="e => OnModelRadioChange(e)" />
            @ReadModel
        </label>

        <label>
            <input name="model" type="radio"
                   value="@LayoutModel"
                   @onchange="e => OnModelRadioChange(e)" />
            @LayoutModel
        </label>

        <label>
            <input name="model" type="radio"
                   value="@InvoiceModel"
                   @onchange="e => OnModelRadioChange(e)" />
            @InvoiceModel
        </label>

        <label>
            <input name="model" type="radio"
                   value="@ReceiptModel"
                   @onchange="e => OnModelRadioChange(e)" />
            @ReceiptModel
        </label>
        <form @onsubmit="AnalyzeDocument">

           
            <button type="submit" class="ask-button" disabled="@isBusy">
                <span>Send document to model for analysis</span>
            </button>

            <!-- call wait panel -->
            @if (isBusy)
            {
                <LoadingPanel></LoadingPanel>
            }
        </form>
    </div>
</div>

<div class="doc-area">

    <div class="doc-display-area">
        @if (string.IsNullOrEmpty(StateContainer.PdfUrl)) { StateContainer.PdfUrl = "Pdf/empty-pdf.pdf"; }

        <iframe src="@($"{StateContainer.PdfUrl}#toolbar=0&navpanes=0&scrollbar=0&view=FitH")"></iframe>
    </div>

    <div class="doc-analysis-area">
        <div>
            <label for="docContent">Document content:</label>
            <textarea readonly value="@StateContainer.DocContent"></textarea>
        </div>

        <div>
            <label for="docFields">Documument fields:</label>
            <textarea readonly value="@StateContainer.DocFields"></textarea>
        </div>

        <div>
            <label for="executionLog">Execution log:</label>
            <textarea readonly value="@StateContainer.ExecutionLog"></textarea>
        </div>

        <div>
            <label for="statistics">Model statistics:</label>
            <textarea readonly value="@StateContainer.Statistics"></textarea>
        </div>
    </div>

</div>

@code {


}

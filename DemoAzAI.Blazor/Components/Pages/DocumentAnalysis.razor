@page "/document-analysis"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Blazor.Components.Fragments


<PageTitle>Document Analysis</PageTitle>

<PageDescription Title="Document Analysis"
                 Model="Ai service: Azure Document Intelligence / Form Recognizer"
                 Description="Description: Intelligent document analysis service.">
</PageDescription>

<div class="pdf-model-selection-area">
    <div class="pdf-selection-area">
        <p>Select a PDF document to analyse:</p>
        <button @onclick='() => StateContainer.PdfUrl = "/Pdf/fake-occular-center.pdf"'>
            fake-occular-center
        </button>

        <button @onclick='() => StateContainer.PdfUrl = "/Pdf/fake-lamp-receit.pdf"'>
            fake-lamp-receit
        </button>

        <button @onclick='() => StateContainer.PdfUrl = "/Pdf/fake-kayak-certificate.pdf"'>
            fake-kayak-certificate
        </button>

    </div>

    <div class="ai-model-selection-area">
        <p>Select a model for the analysis:</p>
        <label>
            <input name="model" type="radio"
                   value="@ReadModel"
                   @onchange="e => OnModelRadioChange(e)" />
            @ReadModel
        </label>

        <label>
            <input name="model" type="radio"
                   value="@LayoutModel"
                   @onchange="e => OnModelRadioChange(e)" />
            @LayoutModel
        </label>

        <label>
            <input name="model" type="radio"
                   value="@InvoiceModel"
                   @onchange="e => OnModelRadioChange(e)" />
            @InvoiceModel
        </label>

        <label>
            <input name="model" type="radio"
                   value="@ReceiptModel"
                   @onchange="e => OnModelRadioChange(e)" />
            @ReceiptModel
        </label>

        <form @onsubmit="AnalyzeDocument">
      
            <button type="submit" class="ask-button" disabled="@isBusy">
                <span>Send document to model for analysis</span>
            </button>

            <!-- call wait panel -->
            @if (isBusy)
            {
                <LoadingPanel Message="Sending document to ai document analysis model..."></LoadingPanel>
            }
        </form>
    </div>
</div>

<div class="doc_view_result_area">

    <div class="doc_view_area">
        <iframe src="@($"{StateContainer.PdfUrl}#toolbar=0&navpanes=0&scrollbar=0&view=FitH")"></iframe>
    </div>

    <div class="doc_result_area">

            <label for="docContent">Document content:</label>
            <textarea readonly value="@StateContainer.DocContent"></textarea>
            <label for="docFields">Documument fields:</label>
            <textarea readonly value="@StateContainer.DocFields"></textarea>

        <ExecutionStepsPanel executionSteps="@StateContainer.ExecutionSteps"></ExecutionStepsPanel>
        <StatisticsPanel Statistics="@StateContainer.Statistics"></StatisticsPanel>

    </div>
</div>




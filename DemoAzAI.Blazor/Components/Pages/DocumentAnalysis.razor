@page "/document-analysis"
@inherits BasePage
@rendermode InteractiveServer

@inject ILogger<DocumentAnalysis> Logger

@using DemoAzAI.Blazor.Components.Fragments


<PageTitle>Document Analysis</PageTitle>

<PageDescription Title="Document Analysis"
                 Model="Ai service: Document Intelligence / Form Recognizer (Microsoft Azure)"
                 Description="Description: Intelligent document analysis service.">
</PageDescription>

<div class="ai-model-selection-area">
    <p>Select a model for the analysis:</p>

    <select class="model-select"
            @bind="SelectedModel">
        <option value="@_readModel">@_readModel</option>
        <option value="@_layoutModel">@_layoutModel</option>
        <option value="@_invoiceModel">@_invoiceModel</option>
        <option value="@_receiptModel">@_receiptModel</option>
    </select>

    <form @onsubmit="AnalyzeDocument">

        <button type="submit" class="ask-button" disabled="@isBusy">
            <span>Analyse document</span>
        </button>

        @if (isBusy)
        {
            <LoadingPanel Message="Sending document to ai document analysis model..." />
        }
    </form>
</div>

<div class="pdf-model-selection-area">
    <div class="pdf-selection-area">
        <p>Select a PDF document to analyse:</p>
        <button @onclick='() => pdfUrl = "/Pdf/fake-occular-center.pdf"'>
            fake-occular-center
        </button>

        <button @onclick='() => pdfUrl = "/Pdf/fake-lamp-receit.pdf"'>
            fake-lamp-receit
        </button>

        <button @onclick='() => pdfUrl = "/Pdf/fake-kayak-certificate.pdf"'>
            fake-kayak-certificate
        </button>

    </div>

 
</div>

<div class="doc_view_result_area">

    <div class="doc_view_area">
        @* <iframe src="@($"{StateContainer.PdfUrl}#toolbar=0&navpanes=0&scrollbar=0&view=FitH")"></iframe> *@
        <iframe src="@($"{pdfUrl}#toolbar=0&navpanes=0&scrollbar=0&view=FitH")"></iframe>
    </div>

    <div class="doc_result_area">

        <label for="docContent">Document text:</label>
        <textarea readonly value="@documentText"></textarea>
        <label for="docFields">Document content:</label>
        <textarea readonly value="@documentContent"></textarea>

        <ExecutionStepsPanel executionSteps="@executionLog"></ExecutionStepsPanel>
        <StatisticsPanel Statistics="@statistics"></StatisticsPanel>

    </div>
</div>



@code {

    private static string _readModel = "prebuilt-read";
    private static string _layoutModel = "prebuilt-layout";
    private static string _invoiceModel = "prebuilt-invoice";
    private static string _receiptModel = "prebuilt-receipt";

    public string SelectedModel { get; set; } = _readModel;

    private string pdfUrl = "Pdf/empty-pdf.pdf";

    private string executionLog = string.Empty;
    private string statistics = string.Empty;

    private string documentText = string.Empty;
    private string documentContent = string.Empty;
}

@page "/document-analysis"
@inherits BasePage
@rendermode InteractiveServer

@inject ILogger<DocumentAnalysis> Logger

@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Domain.Models.DocumentAnalysis


<div class="title-area">
    <PageTitle>Document Analysis Page</PageTitle>

    <PageDescription Title="Document Analysis Page"
                     Model="Ai service: Document Intelligence / Form Recognizer (Microsoft Azure)"
                     Description="Description: Intelligent document analysis service.">
    </PageDescription>

</div>

<div class="page-area">
    <div class="document-selected-area">
        <div>Document selected: <span>@documentSelected</span></div>
    </div>

    <div class="document-analysis-area">
        <div class="model-selection-area">
            <p>Select a model for the analysis:</p>

            <label for="@SelectedModel">Available models:</label>

            <select class="model-select"
                    @bind="SelectedModel">
                <option value="@_readModel">@_readModel</option>
                <option value="@_layoutModel">@_layoutModel</option>
                <option value="@_invoiceModel">@_invoiceModel</option>
                <option value="@_receiptModel">@_receiptModel</option>
            </select>
        </div>

        <div class="analyse-store-document-area">
            <div class="analyse-document-area">
                <form @onsubmit="AnalyzeDocument">

                    <button type="submit" class="ask-button" disabled="@sendDocumentAnalysisBusy">
                        <span>Analyse document</span>
                    </button>

                    @if (sendDocumentAnalysisBusy)
                    {
                        <LoadingPanel Message="Sending document to ai document analysis model..." />
                    }
                </form>


            </div>

            <div class="store-document-area">
                <form @onsubmit="SaveAnalysisToStore">
                    <button type="submit" class="ask-button" disabled="@SaveAnalysisToStoreButtonDisabled()">
                        <span>Save analysis to store</span>
                    </button>

                    @if (storeDocumentAnalysisBusy)
                    {
                        <LoadingPanel Message="Saving document analysis to application store..." />
                    }
                </form>


            </div>
        </div>

    
    </div>

    <div class="execution-steps-area">
        <ExecutionStepsPanel ExecutionSteps="@executionSteps"></ExecutionStepsPanel>

    </div>

    <div class="document-analysis-result-area">
        <div class="document-extracted-text">
            <label for="documentExtractedText">Extracted text:</label>
            <textarea>@documentExtractedText</textarea>
        </div>

        <div class="document-extracted-sections">
            <label for="documentExtractedSections">Extracted sections:</label>
            <textarea>@documentExtractedSections</textarea>
        </div>
    </div>

</div>


@code {

    private string executionSteps { get; set; } = string.Empty;

    private string documentSelected { get; set; } = string.Empty;

    private bool sendDocumentAnalysisBusy;
    private bool storeDocumentAnalysisBusy;

    public string SelectedModel { get; set; } = _readModel;

    private static string _readModel = "prebuilt-read";
    private static string _layoutModel = "prebuilt-layout";
    private static string _invoiceModel = "prebuilt-invoice";
    private static string _receiptModel = "prebuilt-receipt";

    private string documentExtractedText = string.Empty;
    private string documentExtractedSections = string.Empty;
}

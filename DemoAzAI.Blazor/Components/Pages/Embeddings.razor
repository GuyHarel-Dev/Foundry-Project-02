@page "/embeddings"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Contracts.Requests
@using DemoAzAI.Contracts.Responses
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.Api
@using DemoAzAI.Blazor.Services.UI
@using DemoAzAI.Contracts.Dtos
@using DemoAzAI.Common

@inject FoundryApiClient apiClient

<textarea @bind="TextToEmbedd"></textarea>

<form @onsubmit="EmbeddText">
    <button type="submit">Submit</button>
    <!-- call wait panel -->
    @if (isBusy)
    {
        <LoadingPanel Message="Sending text for embedding to the embedding model..."></LoadingPanel>
    }
</form>

<textarea @bind="TextGuid"></textarea>

<div class="doc-analysis-area">
    <div>
        <label for="executionLog">Execution log:</label>
        <textarea readonly value="@ExecutionLog"></textarea>
    </div>

    <div>
        <label for="statistics">Model statistics:</label>
        <textarea readonly value="@Statistics"></textarea>
    </div>
</div>

@code {

    private bool isBusy;
    private string TextToEmbedd = TextToEmbeddDefault;
    private string TextGuid = string.Empty;

    private string ExecutionLog = string.Empty; 
    private string Statistics = string.Empty;

    private async Task EmbeddText()
    {

        try
        {
            isBusy = true;

            Statistics = string.Empty;
            ExecutionLog = string.Empty;

            StepTracer.ClearSteps();
            StepTracer.AddStep( "BlazorUi", $"{nameof(EmbeddText)}: Starting embedding for text: {TextToEmbedd.Substring(0, 32)}...");

            ExecutionLog = StepTracer.GetSteps();

            await RefreshUI();

            List<string> lines = TextToEmbedd
                .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                .ToList();

            var request = new EmbeddingTextLRequestDto
            {
                TextLines = lines
            };

            var response = await apiClient.PostAsync<EmbeddingTextLRequestDto, EmbeddingTextResponseDto>("api/embedding/embedlines", request);

            if (!response.IsSuccess)
            {
                ExecutionLog = response.ErrorMessage ?? "Unknown API error.";
                return;

            }

            if (response.Value == null)
            {
                ExecutionLog = "API error: response value is null.";
                return;
            }

            EmbeddingTextResponseDto result = response.Value;


        }
        catch (Exception ex)
        {

            ExecutionLog = ex.Message;
            throw;
        }
        finally
        {
            isBusy = false;
        }

    }
    
    private static string TextToEmbeddDefault = @"Invoice / Facture
CÉLINE FICTIVE
3345 BOULEVARD FICTIF APPARTEMENT 001
Paid / Payé
Fictive City (FC) A1B 2C3
Sold by / Vendu par: Lampes Internationales Inc
CA.";

}

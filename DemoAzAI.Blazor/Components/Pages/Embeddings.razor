
@page "/embeddings"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Api.Contracts.Requests
@using DemoAzAI.Api.Contracts.Responses
@using DemoAzAI.Application
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.Api

@inject FoundryApiClient apiClient
@inject IStepTracer StepTracer

<label for="TextToEmbed">Text to embed:</label>
<textarea @bind="textToEmbed"></textarea>

<form @onsubmit="EmbedText">
    <button type="submit">Generate Embeddings</button>
    <!-- call wait panel -->
    @if (isBusy)
    {
        <LoadingPanel Message="Sending text for embedding to the embedding model..."></LoadingPanel>
    }
</form>

<div>
    <div>
        <label for="embeddedText">Text embedding:</label>
        <textarea readonly value="@embeddedText"></textarea>
    </div>
    <div>
        <label for="executionSteps">Execution log:</label>
        <textarea readonly value="@executionSteps"></textarea>
    </div>


</div>

<div>
    <label for="semanticQuestion">Semantic search:</label>
    <textarea readonly value="@semanticQuestion"></textarea>
    <form @onsubmit="SemanticSearch">
        <button type="submit">Perform semantic search</button>

    </form>

    <div>
        <label for="searchSteps">Semantic search log:</label>
        <textarea readonly value="@searchSteps"></textarea>
    </div>
</div>

@code {

    private bool isBusy;
    private string textToEmbed = TextToEmbedDefault;

    private string embeddedText = string.Empty;
    private string executionSteps = string.Empty;
    private string searchSteps = string.Empty;

    private string semanticQuestion = string.Empty;

    private async Task SemanticSearch()
    {
        if (string.IsNullOrWhiteSpace(semanticQuestion))
        {
            semanticQuestion = "Please enter a semantic question...";
            return;
        };

        var request = new EmbeddingRequestDto
        {
            Chunks = semanticQuestion
                .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                .ToList()
        };

        searchSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(SemanticSearch)}: Embedding the semantic search question...", clearSteps: true);

        var (postStatus, postResult) = await PostEmbeddingApiRequest(request);

        searchSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(SemanticSearch)}: Searching embedding store...");


        searchSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(SemanticSearch)}: Displaying best answers...");

        await RefreshUI();
    }

    private async Task EmbedText()
    {

        try
        {
            isBusy = true;

            embeddedText = string.Empty;
            executionSteps = string.Empty;

            executionSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(EmbedText)}: Starting embedding text...", clearSteps: true);

            await RefreshUI();

            List<string> lines = textToEmbed
                .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                .ToList();

            var request = new EmbeddingRequestDto
            {
                Chunks = lines
            };

            var (postStatus, postResult) = await PostEmbeddingApiRequest(request);

            executionSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(EmbedText)}: Received embedding vectors...");

            if (!postStatus || postResult == null)
            {
                executionSteps = AddUiStepperStep(StepTracer, "BlazorUi", $"{nameof(EmbedText)}: Failed to get embedding vectors.");
                return;
            };
            
            embeddedText = postResult.GetSummary();
        }
        catch (Exception ex)
        {
            executionSteps = ex.Message;
        }
        finally
        {
            isBusy = false;
        }

    }

    private async Task<(bool Success, EmbeddingResponseDto?)> PostEmbeddingApiRequest(EmbeddingRequestDto request)
    {
        if (request == null)
        {
            executionSteps = "Embedding request is null.";
            return (false, null);
        }

        var response = await apiClient.PostAsync<EmbeddingRequestDto, EmbeddingResponseDto>("api/embedding/embed", request);

        if (response == null)
        {
            executionSteps = "API error: no response received.";
            return (false, null);
        }

        if (!response.IsSuccess)
        {
            executionSteps = response.ErrorMessage ?? "Unknown API error.";
            return (false, null);

        }

        if (response.Value == null)
        {
            executionSteps = "API error: response value is null.";
            return (false, null);
        }

        return (true, response.Value);
    }

    

    private static string TextToEmbedDefault = @"Cats are playful pets
Dogs are loyal animals
Pizza is delicious
Machine learning uses vectors";

}

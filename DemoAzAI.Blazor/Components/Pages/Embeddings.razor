@page "/embeddings"
@rendermode InteractiveServer

@using DemoAzAI.Contracts.Requests
@using DemoAzAI.Contracts.Responses
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.Api

@inject FoundryApiClient apiClient

<textarea @bind="TextToEmbedd"></textarea>

<form @onsubmit="EmbeddText">
    <button type="submit">Submit</button>
    <!-- call wait panel -->
    @if (isBusy)
    {
        <LoadingPanel></LoadingPanel>
    }
</form>

<textarea @bind="TextGuid"></textarea>


@code {

    private bool isBusy;
    private string TextToEmbedd = string.Empty;
    private string TextGuid = string.Empty;

    private async Task EmbeddText()
    {

        try
        {
            isBusy = true;

            var request = new EmbeddingTextRequestDto
            {
                Text = TextToEmbedd
            };

            var response = await apiClient.PostAsync<EmbeddingTextRequestDto, EmbeddingTextResponseDto>("api/embedding/embedtext", request);

            if (response is not null && response.Value is not null)
            {
                TextGuid = response.Value.EmbeddedTextGuid.ToString();
            }
        }
        catch (Exception ex)
        {

            // executionLog = ex.Message;
            throw;
        }
        finally
        {
            isBusy = false;
        }

    }
}

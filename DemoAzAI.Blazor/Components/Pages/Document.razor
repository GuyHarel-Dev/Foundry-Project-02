@page "/documents"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.PageStateContainers
@using DemoAzAI.Domain.Models

@inject DocumentSelectionPageState PageState

<PageTitle>Document Selection Page</PageTitle>

<PageDescription Title="Document Selection Page"
                 Model=""
                 Description="Select a document from the document store."
                 PageLog="@GetPageBaseExecutionErrorsString()">
</PageDescription>


<div class="document-selection-area">
    <div class="title">Select or upload a document:</div>
    <div class="select-document">
        <select class="select-document" @onchange="OnDocumentSelected">
            @if (storedDocumentInfo is not null)
            {
                foreach (var info in storedDocumentInfo)
                {
                    <option value=@info.FileName>@info.FileName</option>
                }
            }

        </select>
    </div>

</div>


<div class="doc-view-area">
    @if (selectedDocumentInfo is not null)
    {
        <object class="doc-view-object" data="@GetDocumentInfoApiRoute()"
                type="application/pdf">
        </object>
    }

</div>

@code {

    private List<DocumentInfo> storedDocumentInfo { get; set; } = new();
    private DocumentInfo? selectedDocumentInfo { get; set; }
}

    
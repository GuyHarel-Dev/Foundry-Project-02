@page "/semantic"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Application
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Domain.Models
@using DemoAzAI.Domain.Entities

@inject IExecutionStepTracer StepTracer
@inject ILogger<Semantic> Logger

<PageTitle>Semantic Analysis</PageTitle>

<PageDescription Title="Semantic Analysis"
                 Model="AI Model: text-embedding-3-small (OpenAI)"
                 Description="Description: Generates semantic representations used for knowledge retrieval, similarity matching, and intelligent search."
                 PageLog="@GetPageBaseExecutionErrorsString()">
</PageDescription>

<div class="page-area">
    <div class="select-document-text-area">
        <span>Select a document stored results:</span>
        <select @onchange="OnDocumentSelected">
            @if (storedEmbeddings != null)
            {
                foreach (var doc in storedEmbeddings)
                {
                    <option value="@doc.FileName">@doc.FileName</option>
                }
            }

        </select>

    </div>


    <div class="document-knowledge-area">
        <label>Selected document knowledge:</label>
        <textarea @bind="documentKnowledge"></textarea>
    </div>

    <div class="semantic-search-area">

        <label>Semantic search:</label>
        <form @onsubmit="SearchEmbeddings">
            <label for="searchPhrase">Enter a phrase to research:</label>
            <input class="search-phrase" @bind="searchPhrase" placeholder="Enter your search phrase..." />

            <button type="submit" class="ask-button" disabled="@semanticSearchIsBusy">
                <span>Search document knowledge</span>
            </button>

            <!-- call wait panel -->
            @if (semanticSearchIsBusy)
            {
                <LoadingPanel Message="Performing semantic search using embeddings..."></LoadingPanel>
            }
        </form>

    </div>

    
    <div class="semantic-search-result-area">
        <textarea @bind="searchResult"></textarea>
    </div>

</div>

@code {

    private IEnumerable<DocumentInfo>? storedEmbeddings { get; set; }

    private string? documentKnowledge { get; set; } = string.Empty;

    private string? searchPhrase { get; set; } = string.Empty;
    private string? searchResult { get; set; } = string.Empty;

    private DocumentKnowledgeEntity? selectedDocumentKnowledgeEntity { get; set; }

    private bool semanticSearchIsBusy;

}

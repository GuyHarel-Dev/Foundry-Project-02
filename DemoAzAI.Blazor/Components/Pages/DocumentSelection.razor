@page "/document-selection"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Blazor.Services.UI
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Blazor.Services.StateContainers

@inject UiStateContainer UiState

<PageTitle>Document Selection Page</PageTitle>

<PageDescription Title="Document Selection Page"
                 Model=""
                 Description="Select a document to analyse.">
</PageDescription>

<div class="document-selection-area">
    <div class="title">Select or upload a document:</div>
    <div class="select-document">
        <label for="@SelectedDocument">Demo documents:</label>
        <select class="model-select" @onchange="OnDocumentSelected">
            @foreach (var doc in UiState.DocumentSelection.AvailableDocuments)
            {
                <option value="@doc.Id">@doc.FileName</option>
            }

        </select>

    </div>

    <form @onsubmit="UploadDocument">

        <button type="submit" class="ask-button" disabled>
            <span>Upload document</span>
        </button>

    </form>
</div>

<div class="doc_view_area">
    <iframe src="@($"{SelectedDocument.FilePath}#toolbar=0&navpanes=0&scrollbar=0&view=FitH")"></iframe>
</div>

@code {
    public UiStateDocumentInfo SelectedDocument { get; set; } = new();
    private List<UiStateDocumentInfo> AvailableDocuments { get; set; } = new();

    private async Task OnDocumentSelected(ChangeEventArgs e)
    {
        if (e.Value == null)
        {
            return;
        }

        var docId = e.Value.ToString();
        SelectedDocument = UiState.DocumentSelection.AvailableDocuments.First((doc) => doc.Id == docId);
        UiState.DocumentSelection.SelectedDocument = SelectedDocument;
    }

    private void UploadDocument()
    {

    }

    protected override async Task OnInitializedAsync()
    {
        var documents = new List<UiStateDocumentInfo>() {
            new UiStateDocumentInfo { Id = "1", FileName = "Empty PDF", FilePath = "/Pdf/empty-pdf.pdf" },
            new UiStateDocumentInfo { Id = "2", FileName = "Ocular Center Invoice", FilePath = "/Pdf/fake-occular-center.pdf" },
            new UiStateDocumentInfo { Id = "3", FileName = "Lamp Receipt", FilePath = "/Pdf/fake-lamp-receit.pdf" },
            new UiStateDocumentInfo { Id = "4", FileName = "Kayak Certificate", FilePath = "/Pdf/fake-kayak-certificate.pdf" }
        };

        UiState.DocumentSelection.AvailableDocuments = documents;
        UiState.DocumentSelection.SelectedDocument = documents.First();
        SelectedDocument = UiState.DocumentSelection.SelectedDocument;
    }

}

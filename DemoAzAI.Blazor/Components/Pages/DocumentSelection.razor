@page "/document-selection"
@inherits BasePage
@rendermode InteractiveServer

@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Domain.Entities


<PageTitle>Document Selection Page</PageTitle>

<PageDescription Title="Document Selection Page"
                 Model=""
                 Description="Select a document from the document store.">
</PageDescription>


<div class="document-selection-area">
    <div class="title">Select or upload a document:</div>
    <div class="select-document">
        <button @onclick="LoadDocumentNamesAsync">Click to load available documents</button>
        <select class="select-document" @onchange="OnDocumentSelected">
            @if (docFileNames is not null && docFileNames.Any())
            {
                foreach (var name in docFileNames)
                {
                    <option value=@name>@name</option>
                }
            }
         
        </select>
    </div>

</div>

<div class="doc-view-area">
    @if (docFileNameSelected is not null)
    {
        @if (!string.IsNullOrEmpty(docFileNameSelected))
        {
            <object class="doc-view-object" data="@DocFileNameUrl()"
                    type="application/pdf">
            </object>
        }
    }

</div>

@code {

    private bool loadDocumentIsBusy = false;

    private IEnumerable<string> docFileNames { get; set; } = default!;
    private string? docFileNameSelected { get; set; } = default!;
 
}

    
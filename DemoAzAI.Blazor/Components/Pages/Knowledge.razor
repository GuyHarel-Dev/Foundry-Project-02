@page "/knowledge"
@inherits BasePage
@rendermode InteractiveServer


@using DemoAzAI.Application
@using DemoAzAI.Blazor.Components.Fragments
@using DemoAzAI.Domain.Models

@inject IExecutionStepTracer StepTracer

<PageTitle>Semantic Analysis</PageTitle>

<PageDescription Title="Semantic Analysis"
                 Model="AI Model: text-embedding-3-small (OpenAI)"
                 Description="Description: Extract knowledge from document and create semantic groups (chunks)"
                 PageState="ok"
                 PageLog="@GetPageBaseExecutionErrorsString()">
</PageDescription>

<div class="page-area">

    <div class="select-document-area">
        <span>Select a document stored results:</span>
        <select @onchange="OnDocumentSelected">
            @foreach (var doc in storedDocuments)
            {
                <option value="@doc.Id">@doc.FileName</option>
            }
        </select>

    </div>

    <div class="knowledge-area">

        <div class="document-text-area">
            <label for="DocumentAnalysisText">Text from document analysis:</label>
            <textarea>@documentText</textarea>
        </div>

        <div class="document-extract-area">

            <div class="extract-knowledge">
                <form @onsubmit="ExtractKnowledgeFromText">

                    <button type="submit" class="ask-button">
                        <span>Extract knowledge</span>
                    </button>

                    <label for="saveAnalysisToStore">Save analysis to store</label>
                    <input type="checkbox" @bind="saveKnowledgeChunksToStore" />

                    @if (sendKnowledgeExtractionRequestBusy)
                    {
                        <LoadingPanel Message="Sending knowledge extraction request to api..." />
                    }
                </form>

            </div>

            <div class="display-knowledge">
                <label>Knowledge groups (chunks) extracted:</label>
                <textarea>@documentKnowledgeChunks</textarea>
                <label>Knowledge extraction statistics:</label>
                <textarea>@documentKnowledgeChunksStatistics</textarea>
            </div>

        </div>

    </div>

</div>

@code {

    private bool sendKnowledgeExtractionRequestBusy { get; set; } = false;

    private List<DocumentInfo> storedDocuments { get; set; } = new();

    private string? documentText { get; set; } = string.Empty;
    private string? documentKnowledgeChunks { get; set; } = string.Empty;
    private string? documentKnowledgeChunksStatistics { get; set; } = string.Empty;

    private bool saveKnowledgeChunksToStore { get; set; } = false;

}

@using DemoAzAI.Blazor.Components.Models

<label>@Title</label>

<div class="document-select-area">
    <select class="select-document" @onchange="OnDocumentSelected">
        @if (documents is not null && documents.Any())
        {
            foreach(var doc in documents)
            {
                <option value=@doc.Id>@doc.Name</option>
            }
        }
        else
        {
            <option value="0">(click the load button to load documents)</option>
        }

    </select>

    <button class="load-button" @onclick="LoadDocuments">
        Load
    </button>

</div>

@if (documentLoadingIsBusy)
{
    <LoadingPanel Message="Loading documents from store..."></LoadingPanel>  
}

@code {

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public Func<Task<IEnumerable<DocumentSelectorEntity>>>? LoadDocumentsAsync { get; set; }

    private bool documentLoadingIsBusy { get; set; } = false;

    private IEnumerable<DocumentSelectorEntity>? documents { get; set; } 

    public async Task OnDocumentSelected()
    {

    }

    public async Task LoadDocuments()
    {
        documentLoadingIsBusy = true;


        if (LoadDocumentsAsync is not null)
        {
            documents = await LoadDocumentsAsync.Invoke();
        }

        documentLoadingIsBusy = false;


    }
}


@using DemoAzAI.Abstractions.Entities

<label>@Title</label>

<div class="document-select-area">
    <select class="select-document" @onchange="OnDocumentSelected">
        @if (documents is not null && documents.Any())
        {
            foreach(var doc in documents)
            {
                <option value=@doc.Id>@doc.Name</option>
            }
        }
        else
        {
            <option value="0">@ClickToLoadMessage</option>
        }

    </select>

    <button class="load-button" @onclick="LoadDocuments">
        Load
    </button>

</div>

@if (documentLoadingIsBusy)
{
    <LoadingPanel Message="Loading documents from store..."></LoadingPanel>  
}

@code {

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string ClickToLoadMessage { get; set; } = "(Click the load button)";

    [Parameter]
    public Func<Task<IEnumerable<DocumentEntity>>>? LoadDocumentsFuncAsync { get; set; }

    [Parameter]
    public EventCallback<DocumentEntity> OnDocumentSelectedCallBack { get; set; }

    private bool documentLoadingIsBusy { get; set; } = false;

    private IEnumerable<DocumentEntity>? documents { get; set; } 

    public async Task OnDocumentSelected(ChangeEventArgs e)
    {
        if (e.Value is not null && documents is not null)
        {
            var id = e.Value as string;
            var doc = documents.First(doc => doc.Id == id);
            await OnDocumentSelectedCallBack.InvokeAsync(doc);
        }
    }

    public async Task LoadDocuments()
    {
        documentLoadingIsBusy = true;


        if (LoadDocumentsFuncAsync is not null)
        {
            documents = await LoadDocumentsFuncAsync.Invoke();
        }

        documentLoadingIsBusy = false;


    }
}


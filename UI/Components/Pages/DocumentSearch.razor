@page "/document-search"
@rendermode InteractiveServer

<h3>AI Document Search</h3>
 
<div class="">

        <button @onclick='() => SetPdf("/Pdf/fake-occular-center.pdf")'>
            fake-occular-center
        </button>

        <button @onclick='() => SetPdf("/Pdf/fake-lamp-receit.pdf")'>
            fake-lamp-receit
        </button>

        <button @onclick='() => SetPdf("/Pdf/fake-kayak-certificate.pdf")'>
            fake-kayak-certificate
        </button>

</div>

<div class="column_display">
    <div class="column_1">
        <iframe src="@pdfUrl"></iframe>
    </div>
    <div class="column_2">
        <form @onsubmit="AnalyzeDocument">

            <button type="submit" class="ask-button" disabled="@isBusy">
                <span>Ask</span>
            </button>

            <!-- call wait panel -->
            @if (isBusy)
            {
                <div class="loading-panel-container">
                    <div class="loading-panel" role="status" aria-live="polite">
                        <div class="hourglass"></div>
                        <span>Calling Azure AI Foundry...</span>
                    </div>
                </div>
            }
        </form>
    </div>

</div>



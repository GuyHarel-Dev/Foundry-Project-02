@page "/chat"
@using Shared.DTOs
@using Shared
@using UI.Services
@rendermode InteractiveServer
@inject FoundryApiClient apiClient
@inject ITraceStepper traceStepper

<div>


    <form @onsubmit="SendQuestion">
        <label for="question">Ask a question:</label>
        <input @bind="question" placeholder="Type your question..." />

        <button type="submit">
            Ask
        </button>
    </form>

    <label for="response">Response:</label>
    <textarea readonly value="@response" rows="10" cols="50"></textarea>
</div>

<div>
    <label for="executionLog">Execution log:</label>
    <textarea readonly value="@executionLog" rows="10" cols="50"></textarea>
</div>


@code {
    private string question = "This is just a test. No answer is expected.";
    private string response = string.Empty;
    private string executionLog = string.Empty;

    private async Task SendQuestion()
    {
        try
        {
            traceStepper.AddStep($"{nameof(SendQuestion)}: {question}");
            executionLog = traceStepper.GetTrace();

            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            var request = new ChatRequestDto
            {
                Prompt = question,
                TraceSteps = traceStepper.Steps
            };

            var result = await apiClient.PostAsync<ChatRequestDto, ChatResponseDto>("api/ai/chat/prompt", request);

            if (!result.IsSuccess)
            {
                executionLog = result.ErrorMessage ?? "Unknown API error.";
                return;
            }

            response = result.Value?.Response ?? string.Empty;

            traceStepper.Steps = result.Value?.TraceSteps ?? new List<TraceStepDto>();

            executionLog = traceStepper.GetTrace();
            executionLog += traceStepper.GetTotalTime();


        }
        catch (Exception ex)
        {

            executionLog = ex.Message;
            throw;
        }

    }
}

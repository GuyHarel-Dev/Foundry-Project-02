@page "/chat"
@using SharedDTO
@using UI.Services
@rendermode InteractiveServer
@inject FoundryApiClient apiClient

<div>
    <label for="question">Ask a question:</label>
    <input @bind="question" placeholder="Type your question..." />
    <label for="response">Response:</label>
    <textarea readonly value="@response" rows="10" cols="50"></textarea>
</div>

<div>
    <button @onclick="SendQuestion">Ask</button>
</div>

<div>
    <label for="trace">Ask a question:</label>
    <textarea readonly value="@trace" rows="10" cols="50"></textarea>
</div>


@code {
    private string question = string.Empty;
    private string response = string.Empty;
    private string trace = string.Empty;

    private async Task SendQuestion()
    {
        try
        {
            var request = new ChatRequest
            {
                Prompt = question
            };

            var result = await apiClient.PostAsync<ChatRequest, ChatResponse>("api/ai/chat/prompt", request);

            if (!result.IsSuccess)
            {
                trace = result.ErrorMessage ?? "Unknown API error.";
                return;
            }

            response = result.Value?.Response ?? string.Empty;
        }
        catch (Exception ex)
        {

            trace = ex.Message;
            throw;
        }

    }
}

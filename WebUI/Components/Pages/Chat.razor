@page "/chat"
@rendermode InteractiveServer

@using Shared.DTOs
@using Shared
@using UI.Services
@inject FoundryApiClient apiClient
@inject ITraceStepper traceStepper

<div>

    <!-- ask button -->
    <form @onsubmit="SendQuestion">
        <label for="question">Ask a question:</label>
        <input @bind="question" placeholder="Type your question..." />

        <button type="submit" class="ask-button" disabled="@isBusy">
           <span>Ask</span>
        </button>

        <!-- call wait panel -->
        @if (isBusy)
        {
            <div class="loading-panel-container">
                <div class="loading-panel" role="status" aria-live="polite">
                    <div class="hourglass"></div>
                    <span>Calling Azure AI Foundry...</span>
                </div>
            </div>
        }
    </form>


</div>

<ApiResult Response="@response" ExecutionLog="@executionLog" Statistics="@statistics"></ApiResult>

@code {
    private bool isBusy;
    private string question = "This is just a test. No answer is expected.";
    private string response = string.Empty;
    private string executionLog = string.Empty;
    private string statistics = string.Empty;

    private async Task SendQuestion()
    {
        try
        {
            isBusy = true;

            traceStepper.AddStep(TraceStepperSourceEnum.BlazorUi, $"{nameof(SendQuestion)}: {question}");
            executionLog = traceStepper.GetTrace();

            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            var request = new ChatRequestDto
            {
                Prompt = question,
                TraceSteps = traceStepper.Steps
            };

            var result = await apiClient.PostAsync<ChatRequestDto, ChatResponseDto>("api/ai/chat/prompt", request);

            if (!result.IsSuccess)
            {
                executionLog = result.ErrorMessage ?? "Unknown API error.";
                return;
            }

            response = result.Value?.Response ?? string.Empty;

            traceStepper.Steps = result.Value?.TraceSteps ?? new List<TraceStepDto>();

            executionLog = traceStepper.GetTrace();
            executionLog += traceStepper.GetTotalTime();

            statistics = result.Value.ModelStatistics.ToString();

            var test  = 123;

        }
        catch (Exception ex)
        {

            executionLog = ex.Message;
            throw;
        }
        finally
        {
            isBusy = false;
        }

    }

    private void DisplayResponse()
    {
        // This method can be used to process and display the response if needed.
    }
}

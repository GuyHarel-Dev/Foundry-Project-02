@page "/document-search"
@rendermode InteractiveServer

@using AzureAI.Blazor.Components.Fragments
@using AzureAI.Common
@using AzureAI.Contracts.Requests
@using AzureAI.Contracts.Responses
@using UI.Services

@inject FoundryApiClient apiClient

<h3>AI Document Search</h3>
 
<div class="">

        <button @onclick='() => SetPdf("/Pdf/fake-occular-center.pdf")'>
            fake-occular-center
        </button>

        <button @onclick='() => SetPdf("/Pdf/fake-lamp-receit.pdf")'>
            fake-lamp-receit
        </button>

        <button @onclick='() => SetPdf("/Pdf/fake-kayak-certificate.pdf")'>
            fake-kayak-certificate
        </button>

</div>

<div class="column_display">
    <div class="column_1">
        <iframe src="@($"{pdfUrl}#toolbar=0&navpanes=0&scrollbar=0&view=FitH")" >
        </iframe>
    </div>
    <div class="column_2">
        <form @onsubmit="AnalyzeDocument">
            <label class="radio-option">
                <input name="model" type="radio"
                       value="@ReadModel"
                       @onchange="e => OnModelRadioChange(e)" />
                @ReadModel
            </label>

            <label class="radio-option">
                <input name="model" type="radio"
                       value="@LayoutModel"
                       @onchange="e => OnModelRadioChange(e)" />
                @LayoutModel
            </label>

            <label class="radio-option">
                <input name="model" type="radio"
                       value="@InvoiceModel"
                       @onchange="e => OnModelRadioChange(e)" />
                @InvoiceModel
            </label>

            <label class="radio-option">
                <input name="model" type="radio"
                       value="@ReceiptModel"
                       @onchange="e => OnModelRadioChange(e)" />
                @ReceiptModel
            </label>

            <button type="submit" class="ask-button" disabled="@isBusy">
                <span>Analyze document</span>
            </button>

            <!-- call wait panel -->
            @if (isBusy)
            {
                <LoadingPanel></LoadingPanel>
            }
        </form>
        <ApiResult Response="@response" ExecutionLog="@executionLog" Statistics="@statistics"></ApiResult>
    </div>

</div>

@code {

    [Inject]
    private IWebHostEnvironment Env { get; set; } = default!;
    private bool isBusy;
    private string pdfUrl = "/Pdf/empty-pdf.pdf";

    private string response = string.Empty;
    private string executionLog = string.Empty;
    private string statistics = string.Empty;

    private string ReadModel = "prebuilt-read";
    private string LayoutModel = "prebuilt-layout";
    private string InvoiceModel = "prebuilt-invoice";
    private string ReceiptModel = "prebuilt-receipt";

    private string SelectedModel = "prebuilt-read";

    private async Task OnModelRadioChange(ChangeEventArgs e)
    {
        var test = e.Value;

        SelectedModel = e.Value?.ToString() ?? "prebuilt-read";
        await AddUiStep($"Model selected: {SelectedModel}");
    }

    private async Task AnalyzeDocument()
    {
        try
        {
            isBusy = true;

            response = string.Empty;
            statistics = string.Empty;
            executionLog = string.Empty;

            await AddUiStep($"{nameof(AnalyzeDocument)}: Analyzing: {pdfUrl}");

            var request = new AnalyzeDocumentRequestDto
            {
                ModelName = SelectedModel,
                FileName = Path.GetFileName(pdfUrl),
                Bytes = await File.ReadAllBytesAsync(Path.Combine(Env.WebRootPath, pdfUrl.TrimStart('/')))     
            };

            var result = await apiClient.PostAsync<AnalyzeDocumentRequestDto, 
                AnalyzeDocumentResponseDto>("api/document/analyze", request);

            if (!result.IsSuccess)
            {
                executionLog = result.ErrorMessage ?? "Unknown API error.";
                return;
            }

            response = ExtractDocumentsFields(result.Value);
            statistics = ExtractStatistics(result.Value);

            // executionLog = apiTracer.GetTrace();
            // executionLog += apiTracer.GetTotalTime();

            var test = 123;


        }
        catch (Exception ex)
        {

            executionLog = ex.Message;
            throw;
        }
        finally
        {
            isBusy = false;
        }

    }

    private string ExtractDocumentsFields(AnalyzeDocumentResponseDto? response)
    {
        if (response == null)
            return "No response documents or fields to extract.";

        string str = "";

        foreach (var doc in response.Documents)
        {
            str += $"Document Type: {doc.DocumentType}\n";
            foreach (var field in doc.Fields)
            {
                str += $"\n";
                str += $"  Field Name: {field.Name}\n";
                str += $"    Value: {field.Value}\n";
                str += $"    Confidence: {field.Confidence}\n";
                str += $"    Confidence: {field.FieldType}\n";
            }
        }

        return str;
    }

    private string ExtractStatistics(AnalyzeDocumentResponseDto? response)
    {
        if (response == null)
            return "No response data to extract statistics.";

        string str = "";

        str += $"PageCount: {response.PageCount}\n";
        str += $"ParagraphCount: {response.ParagraphCount}\n";
        str += $"TableCount: {response.TableCount}\n";
        str += $"FigureCount: {response.FigureCount}\n";
        str += $"SectionCount: {response.SectionCount}\n";
        str += $"LanguagesCount: {response.LanguagesCount}\n";
        str += $"LanguagesCount: {response.LanguagesCount}\n";

        // Derived statistics
        str += $"CharacterCount : {response.DocContent.Length}\n";
        str += $"WordCount : {response.DocContent.Split(' ').Length}\n";

        return str;

    }

    private void SetPdf(string url)
    {
        pdfUrl = url;
    }

    private async Task AddUiStep(string message)
    {
        // apiTracer.AddStep(ApiStepTracerTraceeEnum.BlazorUi, message);
        // executionLog = apiTracer.GetTrace();

        await RefreshUI();
    }

    private async Task RefreshUI()
    {

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }
}
